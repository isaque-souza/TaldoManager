[Unit]
Description=Taldo Manager (FastAPI)
After=network.target

[Service]
User=taldo
Group=taldo
WorkingDirectory=/opt/taldo/backend
Environment=TALDO_DB=/var/lib/taldo/taldo_manager.db
# o Caddy serve em HTTPS: o cookie de login só anda cifrado
Environment=TALDO_COOKIE_SEGURO=1
# só escuta a própria máquina; quem fala com a internet é o Caddy.
# --proxy-headers: o IP do jogador vem do Caddy (para o freio de tentativas)
ExecStart=/opt/taldo/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
